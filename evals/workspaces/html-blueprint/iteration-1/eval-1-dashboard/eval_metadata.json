{
  "eval_id": 1,
  "eval_name": "generate-dashboard-blueprint",
  "prompt": "帮我生成一个后台Dashboard页面的HTML设计稿，包含4个统计卡片（销售额、用户数、转化率、项目数），一个项目列表表格，一个销售趋势图。要求能后续转成Vue组件。",
  "assertions": [
    {
      "id": "has-data-page",
      "text": "页面根节点有 data-page 属性",
      "check_method": "content_check"
    },
    {
      "id": "pascal-case-components",
      "text": "所有 data-component 值为 PascalCase 且非泛名",
      "check_method": "content_check"
    },
    {
      "id": "chart-is-manual",
      "text": "图表元素标记 data-convert=\"manual\"",
      "check_method": "content_check"
    },
    {
      "id": "has-convert-annotation",
      "text": "组件元素有 data-convert 属性",
      "check_method": "content_check"
    },
    {
      "id": "has-confidence-report",
      "text": "输出包含转换置信度 JSON 报告",
      "check_method": "content_check"
    },
    {
      "id": "no-generic-classes",
      "text": "CSS class 不使用 box1/left/text2 等泛名",
      "check_method": "content_check"
    },
    {
      "id": "no-important",
      "text": "CSS 不使用 !important",
      "check_method": "content_check"
    }
  ]
}
