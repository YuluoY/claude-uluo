{
  "eval_id": 2,
  "eval_name": "spec-first-form",
  "prompt": "帮我用 Spec-First 工作流生成一个用户信息表单页面。先编写 Design Spec JSON（包含用户表单组件：姓名、邮箱、手机号、部门选择器，含提交和取消事件），然后用 generate-html.js 生成 HTML，用 generate-code.js 生成 React TSX 代码，最后用 check-spec-fidelity.js 校验。",
  "workflow": "spec-first",
  "assertions": [
    {
      "id": "has-valid-spec",
      "text": "Design Spec 通过 validate-spec.js 校验（0 errors）",
      "check_method": "cli_exit_code",
      "command": "node scripts/validate-spec.js spec.json"
    },
    {
      "id": "has-generated-html",
      "text": "生成的 HTML 通过 validate-all.js 校验",
      "check_method": "cli_exit_code",
      "command": "node scripts/validate-all.js output.html"
    },
    {
      "id": "form-has-model",
      "text": "表单元素有 data-model 属性",
      "check_method": "content_check"
    },
    {
      "id": "fields-have-data-field",
      "text": "所有表单控件有 data-field 属性",
      "check_method": "content_check"
    },
    {
      "id": "has-submit-event",
      "text": "Spec 和代码中包含 submit 事件",
      "check_method": "content_check"
    },
    {
      "id": "props-have-types",
      "text": "生成的 React 代码 Props 接口包含类型定义",
      "check_method": "content_check"
    },
    {
      "id": "spec-code-consistency",
      "text": "Spec ↔ 代码一致性校验通过（0 HARD errors）",
      "check_method": "cli_exit_code",
      "command": "node scripts/check-spec-fidelity.js spec.json output.html ./generated"
    }
  ]
}
