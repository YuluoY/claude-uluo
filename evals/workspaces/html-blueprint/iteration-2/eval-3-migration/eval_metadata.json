{
  "eval_id": 3,
  "eval_name": "html-to-spec-migration",
  "prompt": "我有一个现有的 HTML 设计稿（含 data-* 标注），帮我用 html-to-spec.js 逆向生成 Design Spec，补充缺失的 API 契约和状态机字段，然后用 Spec-First 工作流重新生成 HTML 和 Vue 代码，校验一致性。",
  "workflow": "migration",
  "assertions": [
    {
      "id": "has-reverse-generated-spec",
      "text": "html-to-spec.js 成功生成 Spec JSON",
      "check_method": "cli_exit_code",
      "command": "node scripts/html-to-spec.js input.html --out spec.json"
    },
    {
      "id": "spec-has-todo-markers",
      "text": "逆向生成的 Spec 包含 _todo 标记（API 契约、状态机）",
      "check_method": "content_check"
    },
    {
      "id": "spec-valid-after-completion",
      "text": "补充 _todo 字段后 Spec 通过 validate-spec.js 校验",
      "check_method": "cli_exit_code",
      "command": "node scripts/validate-spec.js spec.json"
    },
    {
      "id": "regenerated-html-valid",
      "text": "重新生成的 HTML 通过 validate-all.js 校验",
      "check_method": "cli_exit_code",
      "command": "node scripts/validate-all.js output.html"
    },
    {
      "id": "regenerated-code-valid",
      "text": "重新生成的 Vue 代码文件存在且非空",
      "check_method": "file_exists"
    },
    {
      "id": "full-consistency",
      "text": "Spec ↔ HTML ↔ 代码三角校验通过",
      "check_method": "cli_exit_code",
      "command": "node scripts/check-spec-fidelity.js spec.json output.html ./generated"
    }
  ]
}
